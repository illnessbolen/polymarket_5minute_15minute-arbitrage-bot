{
  "name": "polymarket-updown-arbitrage-bot",
  "version": "2.0.0",
  "description": "Cross-horizon arbitrage bot for Polymarket 5-minute / 15-minute crypto up-or-down markets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "ts-node src/scripts/check.ts",
    "approve": "ts-node src/scripts/approve.ts",
    "redeem": "ts-node src/scripts/redeem.ts",
    "report": "ts-node src/scripts/report.ts"
  },
  "keywords": [
    "polymarket",
    "arbitrage",
    "trading",
    "crypto",
    "prediction-markets"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "1.2.0",
    "dotenv": "^16.4.5",
    "viem": "2.57.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
