# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# paper = simulate fills against the live order book (default, no wallet needed)
# live  = send real orders to Polymarket
TRADING_MODE=paper

# Assets to trade (each has 5m and 15m up/down markets): btc,eth,sol,xrp,doge,bnb,hype
ASSETS=btc,eth,sol,xrp

# ---------------------------------------------------------------------------
# Opportunity thresholds
# ---------------------------------------------------------------------------
# Minimum locked-in profit per share after taker fees (0.01 = 1 cent per $1 payout)
MIN_EDGE=0.01
# Minimum locked-in profit per trade, USD
MIN_PROFIT_USD=0.05
# Size caps per trade (both legs together for USD)
MAX_SHARES_PER_TRADE=200
MAX_USD_PER_TRADE=50
# Extra ticks of price tolerance on each leg (never allowed to make the worst case a loss)
SLIPPAGE_TICKS=0

# ---------------------------------------------------------------------------
# Risk limits
# ---------------------------------------------------------------------------
MAX_USD_PER_WINDOW=150
MAX_TRADES_PER_WINDOW=5
MAX_DAILY_TRADES=200
# Halt trading when settled PnL for the UTC day falls below -MAX_DAILY_LOSS_USD
MAX_DAILY_LOSS_USD=25
# Halt after this many failed/repaired trades in a row
MAX_CONSECUTIVE_FAILURES=3
TRADE_COOLDOWN_MS=2000
# Do not open trades in the last N seconds before settlement
NO_TRADE_LAST_SECONDS=10

# ---------------------------------------------------------------------------
# When only one leg fills
# ---------------------------------------------------------------------------
# Accept up to this loss per share to complete the hedge (pair cost up to 1 + value)
HEDGE_MAX_LOSS_PER_SHARE=0.03
HEDGE_ATTEMPTS=3
HEDGE_RETRY_DELAY_MS=300
# sell = unwind the excess leg at market; hold = keep it (directional risk)
UNHEDGED_ACTION=sell
UNWIND_SLIPPAGE_TICKS=2

# ---------------------------------------------------------------------------
# Paper trading
# ---------------------------------------------------------------------------
# Simulated delay between detection and fill (network + 150 ms taker delay on crypto markets)
PAPER_LATENCY_MS=250

# ---------------------------------------------------------------------------
# Wallet (live mode)
# ---------------------------------------------------------------------------
# Private key of the wallet that signs orders. NEVER commit a real key.
POLY_PRIVATE_KEY=
# 0 = EOA (the key's own address holds the funds; run `npm run approve` once)
# 1 = Polymarket proxy wallet (email / Magic login)
# 2 = Polymarket Safe wallet (browser wallet login)
POLY_SIGNATURE_TYPE=0
# Address that holds your Polymarket funds (shown on polymarket.com); required for types 1 and 2
POLY_FUNDER=
# Polygon RPC (approvals, auto-redeem). It must support eth_simulateV1 for payout checks;
# otherwise the bot falls back to eth_estimateGas.
POLY_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Optional: reuse CLOB API credentials instead of deriving them from the key on start
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# ---------------------------------------------------------------------------
# Automatic redemption of resolved positions (live mode)
# ---------------------------------------------------------------------------
# 1 = redeem winnings automatically (needs a little POL on the signing key for gas)
AUTO_REDEEM=1
REDEEM_INTERVAL_MS=300000
# Do not spend gas on markets whose winning shares are worth less than this (pUSD)
REDEEM_MIN_PAYOUT_USD=1
# updown = only this bot's up/down markets; all = every resolved binary position of the wallet
REDEEM_SCOPE=updown

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
LOG_DIR=./logs
LOG_LEVEL=info
STATUS_INTERVAL_MS=15000
